# Discord 브리지 설정. 브리지를 돌리는 머신에서 .env 로 복사해 채운다:
#   cp .env.example .env && chmod 600 .env
# 봇 토큰은 이 파일에 직접 입력한다. 대화·이슈·위키에 붙여 넣지 않는다.

# ── Discord ────────────────────────────────────────────────────────────────
# Discord Developer Portal > Applications > <내 앱> > Bot > Reset Token
DISCORD_TOKEN=

# 이 채널들의 모든 메시지에 봇이 답한다(멘션 없이도). 쉼표로 구분한다.
# 비워 두면 멘션과 DM 에만 답한다.
ALLOWED_CHANNEL_IDS=

# 이 Discord 사용자 id 만 봇을 쓸 수 있다. 쉼표로 구분한다.
# ⚠️ 필수다. 비워 두면 브리지가 "ALLOWED_USER_IDS 가 비어 있다" 를 출력하고 시작하지 않는다(src/index.js).
#    기본값 PERMISSION_MODE=bypassPermissions 에서는 에이전트가 이 머신에서 셸 명령을 실행하고 파일을 고칠 때
#    묻지 않으므로, 여기에 넣은 사용자는 이 머신의 셸을 가진 것과 같다. 내 id 만 넣는다.
ALLOWED_USER_IDS=

# ── 에이전트 ───────────────────────────────────────────────────────────────
# claude = Claude Agent SDK (기본값)
# codex  = 로컬 codex CLI (.env.second-agent.example 참고)
AGENT_BACKEND=claude

# 에이전트 표시 이름(스레드 이름, 로그, 페르소나 파일의 {{AGENT_NAME}}).
# 비우면 AGENT_BACKEND 에 따라 "Claude" 또는 "Codex".
# 다른 머신의 Claude Code 에이전트와 같은 이름을 쓴다. 같은 에이전트면 같은 위키 콜렉션을 쓴다.
AGENT_NAME=

# 모든 prompt 앞에 붙는 페르소나 텍스트. 상대 경로는 프로세스 작업 디렉터리 기준이다.
# 파일이 없으면 동봉된 persona.example.md 를 쓴다(로그에 경고가 남는다).
PERSONA_FILE=./persona.md

# ── 스레드 기록 컨텍스트 ───────────────────────────────────────────────────
# 새 세션은 스레드/채널의 최근 대화를 받고, 이어지는 세션은 마지막으로 처리한 메시지 뒤에 다른 사람과 봇이
# 쓴 것만 받는다. false = 아무것도 넣지 않는다.
THREAD_CONTEXT_ENABLED=true

# 한 번에 가져오는 최대 메시지 수(기본 30)
THREAD_CONTEXT_MAX_MESSAGES=30

# 기록 블록 전체의 최대 글자 수. 넘으면 오래된 줄부터 버린다(기본 24000, 약 8k 토큰)
THREAD_CONTEXT_MAX_CHARS=24000

# 메시지 하나당 최대 글자 수(기본 500)
THREAD_CONTEXT_MSG_MAX_CHARS=500

# ── 봇 간 대화 정책 ────────────────────────────────────────────────────────
# mention_only = 다른 봇이 이 봇을 명시적으로 멘션할 때만 반응한다(기본값)
# never        = 봇 메시지는 모두 무시한다
RESPOND_TO_BOTS=mention_only

# 이 봇을 부를 수 있는 봇 계정 id. 쉼표로 구분한다. 비우면 어떤 봇도 부를 수 없다.
# ⚠️ 여기에 봇을 넣으면 그 봇에게 이 머신의 셸을 주는 셈이다. 그 봇의 메시지가 에이전트 prompt 가 된다.
#    내가 직접 돌리는 봇만 넣는다.
ALLOWED_BOT_IDS=

# 이 봇에 준 역할 id. 역할 멘션(<@&role>)을 이 봇에 대한 멘션으로 칠 때만 필요하다.
# @everyone / @here 로는 봇이 반응하지 않는다.
BOT_ROLE_IDS=

# 사람 메시지 없이 봇 메시지에 연속으로 답하는 최대 횟수(기본 2). 루프 방지용이다.
BOT_MAX_CHAIN_DEPTH=2

# ── Claude 백엔드 ──────────────────────────────────────────────────────────
# 채널별 작업 디렉터리의 상위 폴더. 실제 cwd 는 <WORKSPACE_DIR>/<channelId>/ 다.
WORKSPACE_DIR=./workspace

# default | acceptEdits | bypassPermissions | dontAsk | plan
# bypassPermissions = 모든 도구가 승인 없이 실행된다(기본값, 무인 운영용)
PERMISSION_MODE=bypassPermissions

# 예: claude-sonnet-5. 비우면 Claude Code CLI 의 기본 모델.
CLAUDE_MODEL=

# 기본 모델이 과부하(529)일 때 쓰는 모델. 기본 claude-sonnet-5. 값을 비우면 fallback 을 쓰지 않는다.
CLAUDE_FALLBACK_MODEL=claude-sonnet-5

# Claude Code CLI 의 API 재시도 횟수(기본 3). CLI 자체 기본값 10 이면 529 한 번이 몇 분 대기로 번질 수 있다.
CLAUDE_CODE_MAX_RETRIES=3

# 요청당 최대 에이전트 턴 수(기본 50)
MAX_TURNS=50

# 요청당 최대 실행 시간, ms 단위(기본 1800000 = 30분). 넘으면 실행을 중단하고 스레드에 알린다.
# codex 백엔드에도 적용된다.
JOB_TIMEOUT_MS=1800000

# 스레드/DM 별 세션 상태 파일(기본 ./sessions.json)
SESSIONS_FILE=./sessions.json

# ── 인증 ───────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY 는 선택이다. 이 머신에서 `claude` CLI 에 로그인해 두었으면(claude login)
# SDK 가 그 자격 증명을 쓴다. API 키를 대신 쓰려면 아래 주석을 풀고 여기에 채운다.
# ANTHROPIC_API_KEY=

# ── codex 백엔드 (AGENT_BACKEND=codex 일 때만) ─────────────────────────────
# codex 실행 파일. 기본 codex(PATH 에서 찾는다). launchd/systemd 에서는 절대 경로를 쓴다.
CODEX_BIN=codex

# 비우면 ~/.codex/config.toml 의 기본 모델(-m 플래그 없음).
CODEX_MODEL=

# read-only | workspace-write | danger-full-access (기본 danger-full-access)
CODEX_SANDBOX=danger-full-access

# minimal | low | medium | high. 비우면 -c model_reasoning_effort 플래그를 붙이지 않는다.
CODEX_REASONING_EFFORT=

# codex 실행 한 번의 최대 시간, ms 단위(기본 1800000 = 30분)
CODEX_TIMEOUT_MS=1800000

# ── 체크아웃 하나로 봇 여러 개 ─────────────────────────────────────────────
# ENV_FILE 로 읽을 env 파일을 고른다. 예: ENV_FILE=.env.second-agent npm start
# ENV_FILE 은 이 파일 안에 적으면 효과가 없다. 프로세스 환경 변수로 준다.
