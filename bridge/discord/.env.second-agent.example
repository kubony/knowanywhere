# ── 같은 체크아웃에서 도는 두 번째 에이전트 (예: codex 백엔드 봇) ──────────
# 이 파일을 .env.second-agent 로 복사해 채운다:
#   cp .env.second-agent.example .env.second-agent && chmod 600 .env.second-agent
#   npm run start:second          (= ENV_FILE=.env.second-agent node src/index.js)
# 첫 번째 봇과 다른 Discord 애플리케이션과 봇 토큰이 따로 필요하다.
# knowanywhere 의 Phase 2 기능이다. 인스톨러가 아직 이것을 설정해 주지 않는다.

AGENT_BACKEND=codex
AGENT_NAME=Nova

# 두 번째 Discord 애플리케이션의 봇 토큰(첫 번째 봇의 토큰이 아니다)
DISCORD_TOKEN=

# 비우면 멘션과 DM 에만 답한다. 첫 번째 봇의 채널을 여기 넣으면 두 봇이 모두 답한다.
ALLOWED_CHANNEL_IDS=

# 첫 번째 봇의 .env 와 같은 값. 이 봇도 이 머신의 셸을 준다.
# 예시 값일 뿐이다. 내 Discord 사용자 id 를 넣는다.
ALLOWED_USER_IDS=123456789012345678

# 이 봇 전용 페르소나 파일(persona.example.md 를 복사해 고친다). {{AGENT_NAME}} 은 AGENT_NAME 으로 바뀐다.
PERSONA_FILE=./persona.second-agent.md

# workspace 는 첫 번째 봇과 같이 써도 된다(같은 채널 = 같은 cwd, 파일 공유).
WORKSPACE_DIR=./workspace

# 세션 파일은 반드시 따로 둔다. codex thread_id 와 Claude session_id 는 형식이 다르다.
SESSIONS_FILE=./sessions.second-agent.json

# 요청당 최대 실행 시간, ms 단위(기본 1800000 = 30분). 백엔드와 상관없이 적용된다. 넘으면 실행을 중단하고
# 스레드에 알린다. 아래 CODEX_TIMEOUT_MS 는 codex 실행 한 번의 제한이다. 바꿀 때만 주석을 푼다.
# JOB_TIMEOUT_MS=1800000

# ── 스레드 기록 컨텍스트 / 봇 간 대화 정책 ─────────────────────────────────
# 첫 번째 봇과 같은 정책을 쓴다. 한 채널의 두 봇 중 하나만 기록을 읽거나 하나만 봇 멘션에 반응하면
# 대화가 어긋난다.
# 아래 값은 모두 기본값이다. 바꿀 때만 주석을 푼다.
# THREAD_CONTEXT_ENABLED=true
# THREAD_CONTEXT_MAX_MESSAGES=30
# THREAD_CONTEXT_MAX_CHARS=24000
# THREAD_CONTEXT_MSG_MAX_CHARS=500

# mention_only = 다른 봇이 이 봇을 명시적으로 멘션할 때만 반응한다(기본값) / never = 봇은 무시한다
# RESPOND_TO_BOTS=mention_only

# 이 봇을 부를 수 있는 봇 계정 id. 비우면 어떤 봇도 부를 수 없다.
# ⚠️ 봇을 넣으면 그 봇에게 이 머신의 셸을 주는 셈이다(danger-full-access).
#    첫 번째 봇 .env 의 ALLOWED_BOT_IDS 와 짝을 맞춘다(대화하려면 서로를 적어야 한다).
# ALLOWED_BOT_IDS=

# 이 봇에 준 역할 id. 역할 멘션을 이 봇에 대한 멘션으로 칠 때만 필요하다.
# BOT_ROLE_IDS=

# 사람 메시지 없이 봇 메시지에 연속으로 답하는 최대 횟수(기본 2). 첫 번째 봇과 같게 둔다.
# BOT_MAX_CHAIN_DEPTH=2

# ── codex CLI ──────────────────────────────────────────────────────────────
# codex 실행 파일 경로. PATH 가 최소한인 곳(launchd, systemd)에서는 절대 경로를 쓴다.
# 예: /opt/homebrew/bin/codex (macOS Homebrew), /usr/local/bin/codex, 또는 `command -v codex` 의 출력.
CODEX_BIN=codex

# 비우면 ~/.codex/config.toml 의 기본 모델.
CODEX_MODEL=

# read-only | workspace-write | danger-full-access
CODEX_SANDBOX=danger-full-access

# minimal | low | medium | high. 비우면 codex 기본값(config.toml).
CODEX_REASONING_EFFORT=

# codex 실행 한 번의 최대 시간, ms 단위(기본 1800000 = 30분)
CODEX_TIMEOUT_MS=1800000
