# systemd template for running the Discord bridge on a Linux VM (for example the knowanywhere GCP VM).
#
# How to fill it in:
#   1. Replace YOUR_USER with the Linux user that owns the checkout and ran `claude login` (or `codex login`).
#      Do not run the bridge as root: the agent gets that user's shell.
#   2. Replace /home/YOUR_USER/knowanywhere/bridge/discord with the absolute path of this folder.
#   3. Replace /usr/bin/node with the output of `command -v node` (Node.js 20 or newer).
#   4. Keep ENV_FILE pointing at this bot's env file (.env, or .env.second-agent for a second bot).
#
# Install and control:
#   sudo cp systemd/knowanywhere-bridge.service /etc/systemd/system/knowanywhere-bridge.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now knowanywhere-bridge
#   systemctl status knowanywhere-bridge --no-pager
#   journalctl -u knowanywhere-bridge -n 50 --no-pager        # last 50 log lines
#   journalctl -u knowanywhere-bridge -f                      # follow
#   sudo systemctl restart knowanywhere-bridge                # after code, persona or .env changes
#
# For a second bot, copy this file to knowanywhere-bridge-second.service and change ENV_FILE.

[Unit]
Description=knowanywhere Discord bridge (Claude Code / Codex agent)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/knowanywhere/bridge/discord
Environment=HOME=/home/YOUR_USER
Environment=PATH=/home/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ENV_FILE=/home/YOUR_USER/knowanywhere/bridge/discord/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
