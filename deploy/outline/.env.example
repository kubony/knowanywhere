# /opt/outline/.env 에 들어갈 Outline 환경 변수
#
# install.sh 가 VM 에서 이 파일을 .env(mode 600)로 복사하고 "install.sh" 라고 적힌 값을 모두 채운다.
# 보통 .env 를 손으로 고칠 일은 없다. 채운 .env 는 커밋하지 않고, 그 값을 대화·위키·state 파일에 붙여 넣지 않는다.
# 비밀값은 변수 이름과 끝 4자리까지만 가리킨다.
#
# 여기 적힌 값은 자리 표시다. CHANGE_ME 값은 install.sh 가 만들거나 입력받는다.

# ---- 호스트 (Caddy 와 install.sh 가 읽는다) ---------------------------------------------------
# 위키의 공개 호스트 이름, scheme 없이. install.sh: --host
WIKI_HOST=wiki.example.com

# ---- VM 에서 만드는 비밀값 -----------------------------------------------------------------------
# 세션과 저장 데이터를 암호화한다. install.sh 가 `openssl rand -hex 32` 로 만든다.
# 함부로 바꾸지 않는다. 바꾸면 모두 로그아웃되고 암호화된 데이터가 깨진다.
SECRET_KEY=CHANGE_ME
# 내부 유틸리티 요청에 서명한다. install.sh 가 `openssl rand -hex 32` 로 만든다.
UTILS_SECRET=CHANGE_ME
# DB 비밀번호. postgres 컨테이너와 DATABASE_URL 안에서 쓴다.
# install.sh 가 `openssl rand -base64 24` 로 만든다(URL-safe 문자만 쓰므로 URL 안에 넣을 수 있다).
POSTGRES_PASSWORD=CHANGE_ME

# ---- 기본 설정 ----------------------------------------------------------------------------------
NODE_ENV=production
# 공개 URL. Google OAuth redirect https://<WIKI_HOST>/auth/google.callback 과 맞아야 한다. install.sh.
URL=https://wiki.example.com
PORT=3000
# Caddy 가 TLS 를 끝내고 http -> https 리다이렉트도 이미 한다. Outline 은 리다이렉트하면 안 된다:
# Caddy 뒤에서 FORCE_HTTPS=true 면 리다이렉트가 끝없이 돈다.
FORCE_HTTPS=false
# 새 사용자의 UI 언어. 예: en_US, ko_KR, de_DE, ja_JP. install.sh: --language
DEFAULT_LANGUAGE=en_US
# IP 별 기본 rate limit. 공개 인터넷에 열린 사이트이므로 켜 둔다.
RATE_LIMITER_ENABLED=true
LOG_LEVEL=info

# ---- DB 와 캐시 (내부 네트워크의 컨테이너) -------------------------------------------------------
# install.sh 가 이 URL 에 비밀번호를 그대로 써 넣는다.
DATABASE_URL=postgres://outline:CHANGE_ME@postgres:5432/outline
# postgres 컨테이너는 내부 네트워크에서 TLS 를 쓰지 않는다.
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

# ---- 파일 저장소: GCS 의 S3 호환 XML API ---------------------------------------------------------
FILE_STORAGE=s3
# outline-storage 서비스 계정의 HMAC 키(06단계). access id 는 비밀이 아니지만 여기에만 둔다.
# install.sh: --hmac-access-id (없으면 입력받는다)
AWS_ACCESS_KEY_ID=CHANGE_ME
# HMAC secret. install.sh 가 화면에 보이지 않게 입력받는다. 명령줄로 넘기지 않는다.
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# GCS 는 region 을 무시하지만 S3 SDK 가 값을 요구한다. 아무 문자열이나 되고, 버킷의 region 을 쓰면 깔끔하다.
AWS_REGION=asia-northeast3
# GCS XML API endpoint. 여기에 버킷 이름을 붙이지 않는다.
AWS_S3_UPLOAD_BUCKET_URL=https://storage.googleapis.com
# uploads 버킷 이름(gs:// 없이), 예 kna-wiki-a1b2-uploads. install.sh: --uploads-bucket
AWS_S3_UPLOAD_BUCKET_NAME=CHANGE_ME
# GCS 에 필수: path-style URL(https://storage.googleapis.com/<bucket>/<key>).
# virtual-hosted 방식은 GCS 에서 서명된 업로드를 깨뜨린다.
AWS_S3_FORCE_PATH_STYLE=true
# 객체는 비공개로 두고, Outline 이 서명된 URL 을 내준다.
AWS_S3_ACL=private
# 브라우저가 presigned POST 로 버킷에 직접 올린다(cors.json 의 CORS 규칙이 필요하다).
AWS_S3_UPLOAD_METHOD=post
# 최대 업로드 크기, 바이트 단위(25 MB).
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400

# ---- 로그인: Google OAuth (05단계) -------------------------------------------------------------
# 웹 클라이언트 ID, .apps.googleusercontent.com 으로 끝난다. 비밀이 아니다. install.sh: --google-client-id
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# client secret. install.sh 가 VM 에서 화면에 보이지 않게 입력받는다.
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ---- knowanywhere 전용 (Outline 은 무시한다) ----------------------------------------------------
# pg-backup.sh 가 쓰는 backups 버킷(gs:// 없이), 예 kna-wiki-a1b2-backups. install.sh: --backups-bucket
BACKUP_BUCKET=CHANGE_ME
